{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "mongo": "powershell -ExecutionPolicy Bypass -File ./scripts/start-mongo-local.ps1",
    "dev": "nodemon index.js",
    "start": "node index.js",
    "generate-secret": "node -e \"console.log(require('crypto').randomBytes(64).toString('hex'))\"",
    "setup": "node -e \"const fs=require('fs');if(!fs.existsSync('.env')){fs.copyFileSync('.env.example','.env');console.log('✅ .env created');}else{console.log('⚠️  .env already exists, skipped');}\"",
    "setup:force": "node -e \"const fs=require('fs');fs.copyFileSync('.env.example','.env');console.log('✅ .env replaced');\"",
    "seed:concours": "node scripts/seedConcoursAnnales.js",
    "seed:exercices": "node scripts/seedExercicesAnnales.js",
    "seed:arabic": "node scripts/seedArabicContent.js",
    "seed:all": "node scripts/seedConcoursAnnales.js && node scripts/seedExercicesAnnales.js && node scripts/seedArabicContent.js"
  },
